---
import ThemeToggle from './ThemeToggle.astro';

const menuItems = [
  { label: 'Главная', href: '/' },
  { label: 'Блог', href: '/blog/' },
  { label: 'Knowledge Graph', href: '/knowledge-graph/' },
  { label: 'О сайте', href: '/about/' },
];
---

<header class="site-header">
  <div class="container flex h-14 items-center justify-between">
    <div class="flex items-center gap-2">
      <button id="menu-toggle" class="md:hidden icon-btn" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
        <span class="block w-6 h-0.5 bg-neutral-600 mb-1 transition-all"></span>
        <span class="block w-6 h-0.5 bg-neutral-600 mb-1 transition-all"></span>
        <span class="block w-6 h-0.5 bg-neutral-600 transition-all"></span>
      </button>
      <a href="/" class="text-xl font-bold text-neutral-900 dark:text-white">
        Dominicus In
      </a>
    </div>

    <nav id="desktop-menu" class="hidden md:flex items-center gap-6">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white transition-colors"
        >
          {item.label}
        </a>
      ))}
      <button id="search-trigger" class="icon-btn" aria-label="Поиск">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 017.5 7.5z" />
        </svg>
      </button>
      <ThemeToggle />
    </nav>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden" aria-label="Мобильное меню">
    <div class="container py-4 space-y-2">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>

  <div id="search-modal" class="fixed inset-0 z-50 hidden bg-black/50 flex items-center justify-center">
    <div class="bg-white dark:bg-neutral-800 rounded-lg shadow-xl max-w-lg w-full mx-4 p-6">
      <h2 class="text-xl font-bold mb-4">Поиск</h2>
      <input
        type="search"
        id="search-input"
        placeholder="Введите для поиска..."
        class="w-full px-4 py-2 border rounded-lg dark:bg-neutral-700 dark:border-neutral-600"
        autofocus
      />
      <div id="search-results" class="mt-4 space-y-2 max-h-80 overflow-y-auto"></div>
      <button id="search-close" class="mt-4 text-sm text-neutral-500">✕</button>
    </div>
  </div>
</header>

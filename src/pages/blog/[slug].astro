---
import Layout from '../../layouts/Layout.astro';
import Footer from "../../components/Footer.astro";
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={post.data.title}
  description={post.data.description ?? ''}
  image={post.data.image ?? '/images/og-default.png'}
>
  <article class="post">
    <header class="post-header mb-8 pb-6 border-b">
      <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>
      <div class="post-meta flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('ru-RU', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>·</span>
        <span>⏱ {Math.ceil((post.body ?? '').split(' ').length / 200)} мин чтения</span>
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex gap-2 mt-4 flex-wrap">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag hover:bg-neutral-200 dark:hover:bg-neutral-700">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>

    {post.next && (
      <link rel="prefetch" href={`/${post.next.slug}/`} as="document" />
    )}
  </article>

  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';

export const prerender = true;
---

<Layout
  title="Knowledge Graph"
  description="Интерактивная карта взаимосвязей между постами, концепциями, людьми и проектами"
>
  <SchemaMarkup
    type="WebApplication"
    name="Knowledge Graph"
    description="Interactive semantic relationship visualization between posts, concepts, people and projects."
  />

  <div class="py-12">
    <h1 class="text-4xl font-bold mb-4">Knowledge Graph</h1>
    <p class="text-neutral-600 dark:text-neutral-400 mb-8">
      Интерактивная карта взаимосвязей между постами, концепциями, людьми и проектами.
      Визуализирует семантические связи по тегам, категориям и датам.
    </p>

    <KnowledgeGraph />

    <div class="mt-8 prose dark:prose-invert">
      <h2>Как работает</h2>
      <p>
        Данный раздел генерируется из реестра тегов и категорий. Каждый узел — это пост,
        каждое ребро — общий тег или категория. Сила связи определяется количеством
        совместно используемых ключевых слов.
      </p>
    </div>
  </div>
</Layout>
